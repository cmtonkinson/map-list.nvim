#!/usr/bin/env sh
set -eu

profile_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$profile_dir/../.." && pwd)

export MAP_LIST_REPO="$repo_root"
export XDG_CONFIG_HOME="$profile_dir/config"
export XDG_DATA_HOME="$profile_dir/data"
export XDG_STATE_HOME="$profile_dir/state"
export XDG_CACHE_HOME="$profile_dir/cache"

mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"

nvim --clean -u "$XDG_CONFIG_HOME/nvim/init.lua" --headless "+PlugInstall --sync" +qa
exec nvim --clean -u "$XDG_CONFIG_HOME/nvim/init.lua" "$@"
