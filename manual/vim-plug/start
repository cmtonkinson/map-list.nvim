#!/usr/bin/env sh
set -eu

profile_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$profile_dir/../.." && pwd)
profile_name=$(basename "$profile_dir")
# Runtime dirs must live outside the repo so the dev plugin's path is not a
# prefix of installed plugin dirs under XDG_DATA_HOME, which would otherwise
# short-circuit plugin attribution to the dev plugin.
runtime_root="${TMPDIR:-/tmp}/map-list-manual/${profile_name}"

export MAP_LIST_REPO="$repo_root"
export XDG_CONFIG_HOME="$profile_dir/config"
export XDG_DATA_HOME="$runtime_root/data"
export XDG_STATE_HOME="$runtime_root/state"
export XDG_CACHE_HOME="$runtime_root/cache"

mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"

nvim --clean -u "$XDG_CONFIG_HOME/nvim/init.lua" --headless "+PlugInstall --sync" +qa
exec nvim --clean -u "$XDG_CONFIG_HOME/nvim/init.lua" "$@"
